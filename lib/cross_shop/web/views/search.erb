<form action="/search" class="search compact">
  <input type="search" name="q" value="<%= @query %>" maxlength="100" required>
  <button type="submit">Search</button>
</form>

<h1>“<%= @query %>”</h1>

<section class="live">
  <% if @saved_engines.any? %>
    <h2>Run this search again?</h2>
    <p>
      The results below were last saved <%= @saved_at.utc.strftime("%-d %b %Y, %H:%M UTC") %> and cost nothing to view.
      Running again fetches fresh results and keeps the current ones as history<% if @history.positive? %> (<%= @history %> earlier saved)<% end %>.
    </p>
  <% else %>
    <h2>Nothing saved for “<%= @query %>” yet</h2>
    <p>Searching the stores fetches live results through SearchApi and saves them.</p>
  <% end %>

  <% if @live %>
    <form method="post" action="/search" class="live-search"
          onsubmit="const n = this.querySelectorAll('input[type=checkbox]:checked').length; return confirm(`This spends up to ${n} SearchApi credit${n === 1 ? '' : 's'}. Continue?`)">
      <input type="hidden" name="authenticity_token" value="<%= Rack::Protection::AuthenticityToken.token(session) %>">
      <input type="hidden" name="q" value="<%= @query %>">
      <input type="hidden" name="refresh" value="<%= @saved_engines.any? ? "1" : "0" %>">
      <% @engines.each do |engine| %>
        <label><input type="checkbox" name="engines[]" value="<%= engine %>" checked> <%= engine.delete_suffix("_search") %></label>
      <% end %>
      <button type="submit"><%= @saved_engines.any? ? "Yes, run again" : "Search the ticked stores" %></button>
      <span class="muted">1 credit per store · <%= @credits_used %> of <%= @credit_limit %> used</span>
    </form>
  <% else %>
    <p class="muted">Live search is off. Start the site with <code>SEARCHAPI_LIVE=1 bin/web</code> to search the stores. Saved results are always free to view.</p>
  <% end %>
</section>

<% unless @result.products.empty? %>
  <p class="summary">
    <% by_store = @result.products.group_by(&:store) %>
    <%= @result.products.size %> listings
    (<%= by_store.map { |store, products| "#{store} #{products.size}" }.join(", ") %>),
    <%= @matched.size %> matched across stores,
    <%= @result.rejects.size %> rejected.
  </p>
  <% unless @result.missing_engines.empty? %>
    <p class="warning">
      Missing: <%= @result.missing_engines.map { |engine, reason| "#{engine} (#{reason})" }.join(", ") %>.
      Missing data is shown as missing, not as “no results”.
    </p>
  <% end %>
  <% @result.notes.each do |engine, note| %>
    <p class="note"><strong><%= engine %>:</strong> <%= note %>.</p>
  <% end %>

  <h2>Matched across stores</h2>
  <% if @matched.empty? %>
    <p class="muted">No listing matched across stores for this query.</p>
  <% end %>
  <% @matched.each do |group| %>
    <% prices = group.map(&:price_min) %>
    <article class="group">
      <header>
        <span class="range">from <%= format("$%.2f", prices.min) %> to <%= format("$%.2f", prices.max) %></span>
        <span class="muted"><%= group.size %> listings</span>
      </header>
      <table>
        <% group.each do |product| %>
          <% candidate = @best[product] %>
          <tr>
            <td class="thumb"><% if product.image %><img src="<%= product.image %>" alt="" loading="lazy" referrerpolicy="no-referrer"><% end %></td>
            <td><span class="store <%= product.store %>"><%= product.store %></span></td>
            <td class="title"><a href="<%= product.link %>" rel="noreferrer noopener" target="_blank"><%= product.title %></a></td>
            <td class="price"><%= price(product) %></td>
            <td><span class="condition <%= product.condition %>"><%= condition_label(product) %></span></td>
            <td class="evidence">
              <% if candidate %>
                <span class="tier <%= candidate.tier %>"><%= (candidate.tier == "style_code") ? "style code #{candidate.evidence}" : candidate.evidence %></span>
              <% else %>
                <span class="muted">anchor</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
    </article>
  <% end %>

  <h2>Not matched</h2>
  <% @unmatched.each do |store, products| %>
    <details class="unmatched">
      <summary><span class="store <%= store %>"><%= store %></span> <%= products.size %> listings</summary>
      <table>
        <% products.sort_by(&:price_min).each do |product| %>
          <tr>
            <td class="title"><a href="<%= product.link %>" rel="noreferrer noopener" target="_blank"><%= product.title %></a></td>
            <td class="price"><%= price(product) %></td>
            <td><span class="condition <%= product.condition %>"><%= condition_label(product) %></span></td>
          </tr>
        <% end %>
      </table>
    </details>
  <% end %>

  <% unless @result.rejects.empty? %>
    <h2>Rejected listings</h2>
    <ul class="rejects">
      <% @result.rejects.each do |reject| %>
        <li><span class="store <%= reject.store %>"><%= reject.store %></span> <code><%= reject.store_id %></code> <%= reject.reason %></li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <% unless @result.missing_engines.empty? || @saved_engines.empty? %>
    <p class="warning">
      No listings to show. <%= @result.missing_engines.map { |engine, reason| "#{engine} (#{reason})" }.join(", ") %>.
    </p>
  <% end %>
<% end %>
